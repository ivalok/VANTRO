<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VANTRO</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            body {
                background-color: #f7f8fa;
                color: #1a1a1a;
            }

            .navbar {
                background-color: #ffffff !important;
                border-bottom: 1px solid #e6e8ec;
            }

            .navbar-brand {
                font-weight: 800;
                letter-spacing: 3px;
                color: #2c3e50 !important;
                font-size: 22px;
            }

            .nav-link {
                color: #444 !important;
                margin-right: 10px;
                transition: 0.25s;
            }

                .nav-link:hover {
                    color: #5c6bc0 !important;
                }

            footer {
                background: #ffffff;
                border-top: 1px solid #e6e8ec;
                padding: 20px 0;
                margin-top: 50px;
                color: #666;
            }
    </style>
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid">

                <!-- LEFT MENU -->
                <div class="collapse navbar-collapse" id="nav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Products">Shop</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Privacy">About</a>
                        </li>
                    </ul>
                </div>

                <!-- CENTER LOGO (replacing SHOP NOW) -->
                <a class="navbar-brand mx-auto text-center" asp-controller="Home" asp-action="Index">
                    VANTRO
                </a>

                <!-- MOBILE TOGGLER -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                    <span class="navbar-toggler-icon"></span>
                </button>

            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="container text-center">
            <div style="font-weight:700; letter-spacing:2px;">VANTRO</div>
            <div style="font-size:12px;">Premium Men's Fashion © 2026</div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>