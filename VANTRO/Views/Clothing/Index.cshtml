@using VANTRO.Models
@model List<Clothing>

<h2>Clothes Shop</h2>

<div style="display:flex; flex-wrap:wrap; gap:15px;">

    @foreach (var item in Model)
    {
        <div style="border:1px solid gray; padding:10px; width:200px;">

            <img src="@item.ImageUrl" width="150" />

            <h3>@item.Name</h3>

            <p>Size: @item.Size</p>

            <p>Color: @item.Color</p>

            <p style="color:@item.Color">● @item.Color</p>

            <p>@item.Price €</p>

        </div>
    }